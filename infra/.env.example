# Copy to .env and fill in values
POSTGRES_USER=gdf
POSTGRES_PASSWORD=change_me_secure
POSTGRES_DB=gdfautomon

REDIS_PASSWORD=change_me_redis

EMQX_DASHBOARD_PASSWORD=change_me_emqx

MQTT_BACKEND_USER=gdf_backend
MQTT_BACKEND_PASSWORD=change_me_backend
MQTT_REALTIME_USER=gdf_realtime
MQTT_REALTIME_PASSWORD=change_me_realtime

# Generate with: cd infra && bash scripts/gen-vapid-keys.sh
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=admin@yourdomain.com

SECRET_KEY=change_me_very_long_random_string

# Optional: FCM server key for mobile push (leave empty to use Web Push only)
FCM_SERVER_KEY=
